# Oura OAuth2 (produccion - recomendado)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
OURA_SCOPES=email personal daily

# Dev fallback: bearer token directo (solo pruebas, expira 30d)
OURA_BEARER_TOKEN=

# Storage
TOKEN_DB_PATH=./data/tokens.sqlite3

# HTTP transport
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# Misc
LOG_LEVEL=INFO
