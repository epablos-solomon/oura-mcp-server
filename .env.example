# Oura OAuth2 (produccion - recomendado)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# En produccion debe ser la URL publica registrada en la app de Oura:
#   https://oura.scaleflow.tech/auth/callback
OURA_REDIRECT_URI=https://oura.scaleflow.tech/auth/callback
# Scopes que cubren toda la informacion disponible de la API v2:
OURA_SCOPES=email personal daily heartrate workout tag session spo2Daily

# Dev fallback: bearer token directo de un solo usuario (solo pruebas, expira 30d)
OURA_BEARER_TOKEN=

# Storage
TOKEN_DB_PATH=./data/tokens.sqlite3

# HTTP transport
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# --- Multi-usuario (transporte http) ---
# YAML que mapea API key -> persona (ver config/tenants.example.yaml)
TENANTS_CONFIG_PATH=./config/tenants.yaml
DEFAULT_TENANT_ID=scaleflow
# user_id usado en stdio / cuando no hay Bearer del MCP
DEFAULT_USER_ID=default
# Secreto para firmar el parametro `state` del flujo OAuth (genera uno aleatorio):
#   python -c "import secrets; print(secrets.token_hex(32))"
OURA_STATE_SECRET=

# --- Webhooks ---
# El mismo verification_token que registras al crear la suscripcion en Oura.
# Si se deja vacio, /webhooks/oura responde 503 (falla cerrado) en vez de
# devolver el challenge a cualquiera que lo pida.
OURA_WEBHOOK_VERIFICATION_TOKEN=

# Misc
LOG_LEVEL=INFO
